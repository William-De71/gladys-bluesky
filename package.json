{
  "name": "gladys-bluesky",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial Gladys Assistant external integration for Bluesky: talk to Gladys in direct messages, post from scenes, scene triggers on mentions, replies and followers, dashboard widgets. Not affiliated with Bluesky Social PBC.",
  "homepage": "https://github.com/William-De71/gladys-bluesky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-bluesky.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "bluesky",
    "atproto",
    "direct-messages",
    "home-automation"
  ]
}
